{
  "name": "media-gallery-backend",
  "version": "1.0.0",
  "description": "Media gallery API: uploads, metadata extraction and thumbnail generation",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "build:client": "npm --prefix ../client run build"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "exifr": "^7.1.3",
    "express": "^4.19.2",
    "file-type": "^21.3.4",
    "mime-types": "^3.0.2",
    "multer": "^2.4.0",
    "music-metadata": "^11.15.0",
    "sharp": "^0.35.4",
    "uuid": "^11.1.1"
  }
}
